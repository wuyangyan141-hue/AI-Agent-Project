# Backend: set in your shell or load with your preferred environment manager.
DATABASE_PATH=data/companion.db
# Optional: without a key, the app runs a deterministic demo agent.
OPENAI_API_KEY=
AGENT_MODEL=openai:gpt-4o-mini
# Frontend: copy VITE_WS_URL to apps/desktop/.env.local if customized.
VITE_WS_URL=ws://127.0.0.1:8000/ws/chat
# RAG embeddings: local = fast offline lexical hash (weaker cross-language).
# openai = semantic embedding model (better recall, needs key + reindex after switch).
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
