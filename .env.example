# 默认离线运行。密钥留空即可使用资料检索、历史、记忆和学习任务。
DATABASE_PATH=data/companion.db
OPENAI_API_KEY=
AGENT_MODEL=openai:qwen-plus
EMBEDDING_PROVIDER=local

# 可选：百炼或其他 OpenAI 兼容服务。地址和密钥必须属于同一地域。
# 将下面地址中的业务空间ID替换为真实值，再取消注释。
# OPENAI_BASE_URL=https://你的业务空间ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 也支持 LLM_API_KEY / LLM_MODEL / LLM_BASE_URL，以及 DASHSCOPE_API_KEY。

# 可选语义向量，启用后需重新索引已有文档。
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://你的业务空间ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_BATCH_SIZE=10
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.16
SEMANTIC_MIN_SCORE=0.45
RAG_CONTEXT_CHARS=12000
MAX_UPLOAD_MB=15
