# 默认离线运行。密钥留空即可使用资料检索、历史、记忆和学习任务。
DATABASE_PATH=data/companion.db
OPENAI_API_KEY=
AGENT_MODEL=openai:qwen-plus
EMBEDDING_PROVIDER=local

# 可选：阿里云百炼 / DashScope（OpenAI 兼容，免费额度见控制台）。
# 推荐通用地址（也可改用业务空间专属域名）：
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_KEY=sk-...
# 也支持 LLM_API_KEY / LLM_MODEL / LLM_BASE_URL。
# 业务空间专属示例：
# OPENAI_BASE_URL=https://你的业务空间ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 可选语义向量，启用后需重新索引已有文档。
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_API_KEY=   # 可留空，会回退到 OPENAI_API_KEY / DASHSCOPE_API_KEY
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_BATCH_SIZE=10
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.16
SEMANTIC_MIN_SCORE=0.45
RAG_CONTEXT_CHARS=12000
MAX_UPLOAD_MB=15
