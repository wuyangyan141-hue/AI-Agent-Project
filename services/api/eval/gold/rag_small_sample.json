{
  "name": "rag_small_sample_v1",
  "description": "Lightweight gold set for report/presentation metrics. Offline extractive RAG; no LLM required.",
  "corpus_file": "corpus/search_basics.txt",
  "cases": [
    {
      "id": "in_01_searching",
      "kind": "in_scope",
      "question": "What is searching and what is the solution in this material?",
      "expect_mode": ["extractive", "llm", "citation_fallback"],
      "must_retrieve_any": ["Searching is the process", "path from the current state", "goal state"],
      "must_answer_any": ["Searching is the process", "path from the current state", "goal state"]
    },
    {
      "id": "in_02_bfs_memory",
      "kind": "in_scope",
      "question": "What makes breadth-first search demanding on memory?",
      "expect_mode": ["extractive", "llm", "citation_fallback"],
      "must_retrieve_any": ["demanding on memory", "unexpanded nodes"],
      "must_answer_any": ["demanding on memory", "unexpanded nodes"],
      "notes": "Avoid leading English 'Why …' — the router treats bare why-followups as clarifications."
    },
    {
      "id": "in_03_dfs_shortest",
      "kind": "in_scope",
      "question": "Does depth-first search generally find the shortest path?",
      "expect_mode": ["extractive", "llm", "citation_fallback"],
      "must_retrieve_any": ["does not find the shortest path", "S-A-C-G"],
      "must_answer_any": ["does not find the shortest path", "S-A-C-G", "shortest path"]
    },
    {
      "id": "in_04_astar",
      "kind": "in_scope",
      "question": "What evaluation function does A* search use?",
      "expect_mode": ["extractive", "llm", "citation_fallback"],
      "must_retrieve_any": ["f(n) = g(n) + h(n)", "g(n)", "h(n)"],
      "must_answer_any": ["f(n) = g(n) + h(n)", "g(n)", "h(n)"]
    },
    {
      "id": "in_05_uninformed",
      "kind": "in_scope",
      "question": "What is uninformed or blind search according to the notes?",
      "expect_mode": ["extractive", "llm", "citation_fallback"],
      "must_retrieve_any": ["without domain heuristic", "Uninformed"],
      "must_answer_any": ["without domain heuristic", "Uninformed", "heuristic"]
    },
    {
      "id": "in_06_bfs_vs_dfs_path",
      "kind": "in_scope",
      "question": "In the S to G route example, what paths do BFS and DFS yield?",
      "expect_mode": ["extractive", "llm", "citation_fallback"],
      "must_retrieve_any": ["S-B-G", "S-A-C-G"],
      "must_answer_any": ["S-B-G", "S-A-C-G"]
    },
    {
      "id": "in_07_genetic",
      "kind": "in_scope",
      "question": "How does a genetic algorithm create new solutions?",
      "expect_mode": ["extractive", "llm", "citation_fallback"],
      "must_retrieve_any": ["fitness", "crossover", "mutation"],
      "must_answer_any": ["fitness", "crossover", "mutation"]
    },
    {
      "id": "para_01_bfs_zh",
      "kind": "paraphrase",
      "question": "为什么 BFS 很占内存？",
      "expect_mode": ["extractive", "llm", "citation_fallback", "no_evidence"],
      "must_retrieve_any": ["demanding on memory", "unexpanded nodes", "Breadth-first", "BFS"],
      "must_answer_any": ["demanding on memory", "unexpanded nodes", "Breadth-first", "BFS", "memory"],
      "notes": "Lexical overlap via BFS/memory; may miss if query expansion fails — tracked as paraphrase hardness."
    },
    {
      "id": "off_01_mars",
      "kind": "off_topic",
      "question": "What is the capital city on Mars?",
      "expect_mode": ["no_evidence"],
      "must_retrieve_any": [],
      "must_answer_any": []
    },
    {
      "id": "off_02_supervised",
      "kind": "off_topic",
      "question": "Explain supervised learning and backpropagation from this document.",
      "expect_mode": ["no_evidence"],
      "must_retrieve_any": [],
      "must_answer_any": [],
      "notes": "Known hard case: 'from this document' can trigger about-doc expansion and weak lexical hits."
    },
    {
      "id": "off_03_macd",
      "kind": "off_topic",
      "question": "How do I trade stocks with the double MACD strategy?",
      "expect_mode": ["no_evidence"],
      "must_retrieve_any": [],
      "must_answer_any": []
    },
    {
      "id": "off_04_quantum",
      "kind": "off_topic",
      "question": "What is the temperature of the sun's core?",
      "expect_mode": ["no_evidence"],
      "must_retrieve_any": [],
      "must_answer_any": []
    }
  ]
}
